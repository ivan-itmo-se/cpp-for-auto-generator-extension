      "}"
    ],
    "description": "for with decreasing variable i"
  },
  "For loop with j and --": {
    "prefix": "forj-",
    "body": [
      "for (int j = $1 - 1; j >= 0; j--) {",
      "    $0;",
      "}"
    ],
    "description": "for with decreasing variable j"
  },
  "For loop with k and --": {
    "prefix": "fork-",
    "body": [
      "for (int k = $1 - 1; k >= 0; k--) {",
